# Base URL the frontend uses for API calls. Leave as /api during local dev —
# vite.config.js proxies /api to the backend so no CORS setup is needed.
# Only set this to a full URL (e.g. https://api.yourapp.com/api) in production.
VITE_API_BASE_URL=/api

# Used only by vite.config.js's dev proxy target — where the backend
# Express server is actually running locally.
VITE_BACKEND_URL=http://localhost:3000
